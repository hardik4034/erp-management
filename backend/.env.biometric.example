# eSSL ADMS Configuration Example
# Copy this to your .env file and fill in your actual credentials

# eSSL ADMS API Configuration
ESSL_ADMS_API_URL=//192.168.1.100:8080
ESSL_ADMS_API_KEY=your_api_key_here
ESSL_ADMS_TOKEN=abc123xyz

# Note: You only need either API_KEY or TOKEN, not both
# Check your eSSL ADMS account dashboard for these credentials
