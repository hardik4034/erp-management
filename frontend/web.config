<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS web.config for HRMS Frontend
    ─────────────────────────────────
    Features:
      1. HTTPS redirect  — all HTTP traffic is 301-redirected to HTTPS
      2. HSTS            — tells browsers to always use HTTPS (1 year)
      3. Security headers — X-Frame-Options, CSP, X-Content-Type, Referrer-Policy
      4. API reverse proxy— /api/* forwarded to Node.js on port 5000
      5. SPA fallback    — unknown routes fall back to login.html
      6. Static MIME     — .json, .webp, .woff2 correctly typed
-->
<configuration>
    <system.webServer>

        <!-- ── Default document ─────────────────────────────────────────── -->
        <defaultDocument>
            <files>
                <clear />
                <add value="login.html" />
            </files>
        </defaultDocument>

        <!-- ── URL Rewrite rules ────────────────────────────────────────── -->
        <!-- Requires IIS URL Rewrite module: https://www.iis.net/downloads/microsoft/url-rewrite -->
        <rewrite>
            <rules>
                <!-- Rule 1: Redirect HTTP → HTTPS -->
                <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                            redirectType="Permanent" />
                </rule>

                <!-- Rule 2: Reverse proxy /api/* → Node.js backend on port 5000 -->
                <!-- Requires IIS Application Request Routing (ARR) module -->
                <rule name="Proxy API to Node.js" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:5000/api/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <!-- ── MIME types ────────────────────────────────────────────────── -->
        <staticContent>
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json"  mimeType="application/json" />
            <mimeMap fileExtension=".webp"  mimeType="image/webp" />
            <mimeMap fileExtension=".woff"  mimeType="font/woff" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>

        <!-- ── HTTP Security Headers ─────────────────────────────────────── -->
        <httpProtocol>
            <customHeaders>
                <!-- Prevent browsers from sniffing the MIME type -->
                <add name="X-Content-Type-Options" value="nosniff" />

                <!-- Block the site from being embedded in iframes (clickjacking) -->
                <add name="X-Frame-Options" value="SAMEORIGIN" />

                <!-- Legacy XSS protection (belt-and-braces for older browsers) -->
                <add name="X-XSS-Protection" value="1; mode=block" />

                <!-- HSTS: Force HTTPS for 1 year including subdomains -->
                <add name="Strict-Transport-Security"
                     value="max-age=31536000; includeSubDomains; preload" />

                <!-- Content Security Policy — tighten per your CDN/font needs -->
                <add name="Content-Security-Policy"
                     value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none';" />

                <!-- Referrer Policy — don't leak URL to third parties -->
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

                <!-- Permissions Policy — disable unused browser APIs -->
                <add name="Permissions-Policy"
                     value="camera=(), microphone=(), geolocation=(), payment=()" />

                <!-- Remove the IIS server version header -->
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>

        <!-- ── Remove IIS Server header ─────────────────────────────────── -->
        <security>
            <requestFiltering removeServerHeader="true" />
        </security>

    </system.webServer>
</configuration>
